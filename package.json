{
    "name": "@domain-first/handlers-mock-rest-adapter",
    "description": "Mock REST Adapter for @domain-first/handlers",
    "version": "1.0.1",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alevnyacow/domain-first-handlers-mock-rest-adapter.git"
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rslib",
        "check": "biome check --write",
        "dev": "rslib --watch",
        "format": "biome format --write",
        "test": "rstest",
        "test:watch": "rstest --watch"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@domain-first/handlers": "^4.0.3",
        "@domain-first/handlers-rest": "^2.0.0",
        "@rslib/core": "^0.23.2",
        "@rstest/adapter-rslib": "^0.10.6",
        "@rstest/core": "^0.10.6",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/npm": "^13.1.5",
        "@types/node": "^24.13.2",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@domain-first/handlers-rest": "^3.0.0"
    }
}
